# Open-weight model. Leave OLLAMA_BASE_URL unset to try localhost:11434.
# Set OLLAMA_BASE_URL=off to force the offline template brief.
OLLAMA_BASE_URL=
GEMMA_MODEL=gemma2:2b

# Auth0 for AI Agents. Human approval JWTs and the RAG permission claim.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Demo-only HMAC secret for local approval tokens. Change it if you share the machine.
APPROVAL_SECRET=sloth-demo

# MongoDB Atlas long-term nap memory.
MONGODB_URI=
MONGODB_DB=slothnap

# Tiger Data (or any Postgres with pgvector) for the dreaded-document pile.
DATABASE_URL=

# Live web search and the page the agent actually opens.
SERPAPI_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Speak the two-line brief.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Paper Instruments Ultramarine, OpenAI-compatible chat completions.
ULTRAMARINE_API_KEY=
ULTRAMARINE_BASE_URL=

# Backboard memory for the assistant.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=

# Sentry agent tracing. Local span files are written either way.
SENTRY_DSN=

# Thinking Machines Tinker. The local before/after eval runs without this.
TINKER_API_KEY=

# Arduino UNO Q serial port, for example /dev/ttyACM0.
ARDUINO_PORT=

# Public URL once a .tech domain points here.
TECH_DOMAIN=

# Temporal. The in-process nap runs without a server.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
